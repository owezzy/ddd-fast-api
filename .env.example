DDD_FAST_API_APP_NAME=ddd-fast-api
DDD_FAST_API_APP_ENV=development
DDD_FAST_API_APP_DEBUG=false
DDD_FAST_API_APP_HOST=127.0.0.1
DDD_FAST_API_APP_PORT=8000
DDD_FAST_API_APP_LOG_LEVEL=INFO
DDD_FAST_API_DATABASE_URL=postgresql+asyncpg://postgres:__LOCAL_DEVELOPMENT_PASSWORD__@localhost:5432/ddd_fast_api
DDD_FAST_API_CATALOG_REPOSITORY_BACKEND=memory
DDD_FAST_API_IDENTITY_REPOSITORY_BACKEND=memory
DDD_FAST_API_AUTH_SECRET=__LOCAL_DEVELOPMENT_AUTH_SECRET__
DDD_FAST_API_AUTH_AUDIENCE=ddd-fast-api
DDD_FAST_API_AUTH_TOKEN_TTL_SECONDS=900
DDD_FAST_API_TELEMETRY_ENABLED=true
DDD_FAST_API_OUTBOUND_TIMEOUT_SECONDS=5
DDD_FAST_API_OUTBOUND_MAX_RETRIES=2
