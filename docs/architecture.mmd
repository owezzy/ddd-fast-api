flowchart LR
    client["Client<br/>Browser, CLI, or service"]

    subgraph service["ddd-fast-api"]
        entrypoints["Entrypoints<br/><small>FastAPI / Starlette</small><br/>Routes, schemas, dependencies"]
        application["Application<br/><small>Python</small><br/>Use cases, authorization, transactions"]
        domain["Domain<br/><small>Plain Python</small><br/>Entities, rules, errors, events, ports"]
        infrastructure["Infrastructure<br/><small>SQLAlchemy / httpx</small><br/>Repositories and external adapters"]
        foundation["Foundation<br/><small>Python</small><br/>Logging, telemetry, settings"]
    end

    postgres[("PostgreSQL<br/>Persistent data")]
    identity[("Identity Provider<br/>Optional OIDC")]
    external[("External Services<br/>Outbound HTTP")]

    client -->|HTTP / JSON| entrypoints
    entrypoints -->|invokes| application
    application -->|applies rules| domain
    application -->|uses ports| infrastructure
    infrastructure -.->|implements ports| domain
    infrastructure -->|SQL| postgres
    infrastructure -->|OIDC| identity
    infrastructure -->|HTTP| external
    foundation -.->|supports| entrypoints
    foundation -.->|supports| application
    foundation -.->|supports| infrastructure

    classDef layer fill:#eff6ff,stroke:#2563eb,color:#172554,stroke-width:2px;
    classDef domainLayer fill:#ecfdf5,stroke:#059669,color:#064e3b,stroke-width:3px;
    classDef external fill:#fff7ed,stroke:#ea580c,color:#7c2d12,stroke-width:2px;
    class entrypoints,application,infrastructure,foundation layer;
    class domain domainLayer;
    class client,postgres,identity,external external;
