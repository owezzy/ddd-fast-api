flowchart LR
    client["Client<br/><small>Browser, CLI, or service</small>"]

    api[["ddd-fast-api<br/><small>FastAPI service</small>"]]
    database[("PostgreSQL<br/><small>Service data</small>")]
    identity[("Identity provider<br/><small>Optional OIDC</small>")]
    external[("External services<br/><small>Outbound HTTP</small>")]

    client -->|HTTP / JSON| api
